# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Mapbox browser token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk_your_public_token

# Database (Neon via Vercel Marketplace)
DATABASE_URL=postgresql://user:password@localhost:5432/progress_map

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Vercel Blob storage (for file uploads - get from Vercel dashboard)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
